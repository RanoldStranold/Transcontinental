{
  "required": true,
  "minVersion": "0.8",
  "package": "net.ranold.mixin",
  "compatibilityLevel": "JAVA_25",
  "mixins": [
    "AbstractMinecartCouplingMixin",
    "AbstractMinecartMixin",
    "AbstractMinecartStandingMixin",
    "EntityStandingCollisionMixin",
    "NewMinecartBehaviorMixin",
    "PlayerStandingEdgeMixin"
  ],
  "client": [
    "client.AbstractMinecartRendererMixin",
    "client.MinecartRenderStateMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
